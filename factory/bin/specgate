#!/usr/bin/env python3
"""Deterministic checks on the spec-writer's files, before anything is built.

Usage:
  specgate spec <spec.md>                 a slice spec the builder can start from
  specgate slices <slices.md> [--done]    the slice table; --done allows no `next` (replan DONE)

Prints `SPECGATE: PASS`, or `SPECGATE: FAIL` and one error per line. Exit 0 on
PASS, 1 on FAIL. The orchestrator hands the errors back to the spec-writer.
"""

import re
import sys
from pathlib import Path

MAX_LINES = 30
MAX_WORDS = 250            # whole spec, without `## Propuesta de split` / `## Preguntas`
MIN_CRITERIA, MAX_CRITERIA = 1, 4
MAX_CRITERION_WORDS = 30   # one idea per criterion, not a paragraph
MAX_VALOR_WORDS = 35
MAX_LIST_ITEMS = 3         # Fuera de alcance, Supuestos
MAX_DEMO_STEPS = 4
STATES = {"next", "idea", "in-progress", "merged", "done", "dropped"}
KINDS = {"slice", "spike"}
ROW = re.compile(r"^\|\s*([A-Za-z0-9_.-]+)\s*\|\s*([^|]*?)\s*\|(.*)\|\s*([^|]*?)\s*\|\s*$")


def section(text, heading):
    m = re.search(rf"^## {re.escape(heading)}[ \t]*\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return m.group(1) if m else None


def words(text):
    return len(re.findall(r"\S+", text))


def items(body, numbered):
    """List items of a section, each with its continuation lines joined."""
    start = r"^\s*\d+\.\s+" if numbered else r"^\s*[-*]\s+"
    out = []
    for line in body.splitlines():
        if re.match(start, line):
            out.append(re.sub(start, "", line))
        elif out and line.strip() and not line.startswith("#"):
            out[-1] += " " + line.strip()
    return out


def check_spec(text):
    errors = []
    lines = text.rstrip("\n").split("\n")
    first = lines[0].strip()
    if first not in {"STATUS: READY", "STATUS: SPLIT"}:
        errors.append(f"first line must be `STATUS: READY` or `STATUS: SPLIT`, not {first!r}")
    if len(lines) > MAX_LINES:
        errors.append(f"{len(lines)} lines; the maximum is {MAX_LINES}")
    body = re.sub(r"^## (Propuesta de split|Preguntas)[ \t]*\n.*?(?=^## |\Z)", "", text, flags=re.M | re.S)
    if words(body) > MAX_WORDS:
        errors.append(f"{words(body)} words; the maximum is {MAX_WORDS}. Cut detail or SPLIT the slice")
    criteria = section(text, "Criterios de aceptación")
    if criteria is None:
        errors.append("missing section `## Criterios de aceptación`")
    else:
        crit = items(criteria, numbered=True)
        if not MIN_CRITERIA <= len(crit) <= MAX_CRITERIA:
            errors.append(f"{len(crit)} numbered criteria; need {MIN_CRITERIA} to {MAX_CRITERIA}")
        for n, c in enumerate(crit, 1):
            if words(c) > MAX_CRITERION_WORDS:
                errors.append(f"criterion {n} has {words(c)} words; the maximum is {MAX_CRITERION_WORDS} "
                              "(one idea per criterion, plain words)")
    for name in ("Valor", "Demo"):
        sec = section(text, name)
        if sec is None:
            errors.append(f"missing section `## {name}`")
        elif not sec.strip():
            errors.append(f"section `## {name}` is empty")
    valor = section(text, "Valor")
    if valor and words(valor) > MAX_VALOR_WORDS:
        errors.append(f"`## Valor` has {words(valor)} words; the maximum is {MAX_VALOR_WORDS} (one sentence)")
    demo = section(text, "Demo")
    if demo and len(items(demo, numbered=True)) > MAX_DEMO_STEPS:
        errors.append(f"`## Demo` has {len(items(demo, numbered=True))} steps; the maximum is {MAX_DEMO_STEPS}")
    for name in ("Fuera de alcance", "Supuestos"):
        sec = section(text, name)
        if sec and len(items(sec, numbered=False)) > MAX_LIST_ITEMS:
            errors.append(f"`## {name}` has {len(items(sec, numbered=False))} items; the maximum is {MAX_LIST_ITEMS}")
    return errors


def check_slices(text, allow_no_next=False):
    errors = []
    if text.lstrip().startswith("STATUS:"):
        errors.append("slices.md must not have a STATUS line (replan.md carries it)")
    rows = []
    for line in text.splitlines():
        m = ROW.match(line)
        if m and m[1] != "ID" and not set(m[1]) <= set("-"):
            rows.append((m[1], m[2], m[4]))
    if not rows:
        errors.append("no slice rows found")
    ids = [r[0] for r in rows]
    for dup in sorted({i for i in ids if ids.count(i) > 1}):
        errors.append(f"slice {dup} appears more than once")
    for i, kind, state in rows:
        if kind not in KINDS:
            errors.append(f"{i}: type {kind!r} isn't one of {', '.join(sorted(KINDS))}")
        if state not in STATES:
            errors.append(f"{i}: state {state!r} isn't one of {', '.join(sorted(STATES))}")
    nexts = [r[0] for r in rows if r[2] == "next"]
    if allow_no_next:
        if nexts:
            errors.append(f"DONE but slices still `next`: {', '.join(nexts)}")
    elif len(nexts) != 1:
        errors.append(f"exactly one `next` is required, found {len(nexts)}")
    return errors


def main(argv):
    if len(argv) not in (2, 3) or argv[0] not in {"spec", "slices"}:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    path = Path(argv[1])
    if not path.exists():
        errors = [f"{path} doesn't exist"]
    elif argv[0] == "spec":
        errors = check_spec(path.read_text())
    else:
        errors = check_slices(path.read_text(), allow_no_next="--done" in argv[2:])
    print("SPECGATE: " + ("FAIL" if errors else "PASS"))
    for e in errors:
        print(f"- {e}")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
