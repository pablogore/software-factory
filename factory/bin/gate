#!/usr/bin/env python3
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md (job merge runs it)
  gate --hook              builder SubagentStop hook: run the checks once, exit 2 on failure

The gate runs the main checkout's factory/checks.sh inside the job's worktree,
so a branch can't change the checks it is judged by. It also fails when the
branch modifies or deletes a file matching config.json `protected_paths`
(fnmatch patterns, where `*` also matches `/`). Adding new files is fine.

`gate <job-id>` runs the checks on the branch merged with a freshly fetched
origin/<base>, in a temporary worktree it removes afterwards: the merge is never
pushed and the job's branch and worktree don't change. It fails without running
the checks when the base can't be fetched or the merge conflicts.
"""

import fnmatch
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text())
CHECKS = FACTORY / "checks.sh"
TAIL = 80


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree, base):
    """Existing files under protected_paths that the branch modified or deleted."""
    diff = git(worktree, "diff", "--name-status", f"origin/{base}...HEAD")
    hits = []
    for line in diff.splitlines():
        status, *paths = line.split("\t")
        if status.startswith("A"):
            continue
        old = paths[0]  # for renames and copies, the original path
        if any(fnmatch.fnmatch(old, pattern) for pattern in CONFIG["protected_paths"]):
            hits.append(f"{status[0]} {old}")
    return hits


def run_checks(worktree):
    start = time.monotonic()
    res = subprocess.run(["bash", str(CHECKS)], cwd=worktree, capture_output=True, text=True)
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def run_merged_checks(worktree, commit, base):
    """checks.sh on `commit` merged with origin/<base> as fetched now, in a temporary
    worktree of its own (its FETCH_HEAD and merge are private to this run).
    Returns (code, log, seconds, base_sha, problem); with a problem the checks didn't run."""
    tmp = tempfile.mkdtemp(prefix="gate-")
    try:
        git(worktree, "worktree", "add", "--detach", tmp, commit)
        fetched = subprocess.run(["git", "fetch", "--no-tags", "--refmap=", "origin", f"refs/heads/{base}"],
                                 cwd=tmp, capture_output=True, text=True,
                                 env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
        if fetched.returncode != 0:
            why = (fetched.stderr or fetched.stdout).strip()
            return None, f"gate: couldn't fetch origin/{base}:\n{why}\n", 0, None, (
                f"Couldn't fetch origin/{base}, so the checks didn't run.\n\n```\n{why}\n```")
        base_sha = git(tmp, "rev-parse", "FETCH_HEAD").strip()
        merged = subprocess.run(["git", "-c", "user.name=factory gate", "-c", "user.email=gate@factory.invalid",
                                 "merge", "--no-edit", base_sha], cwd=tmp, capture_output=True, text=True)
        if merged.returncode != 0:
            files = git(tmp, "diff", "--name-only", "--diff-filter=U").split("\n")
            out = (merged.stdout + merged.stderr).strip()
            return None, f"gate: merging origin/{base} at {base_sha} conflicts:\n{out}\n", 0, base_sha, (
                f"Merging origin/{base} at {base_sha[:7]} into the branch conflicts in:\n\n"
                + "\n".join(f"- {f}" for f in filter(None, files))
                + f"\n\nMerge origin/{base} into the branch, resolve the conflicts and commit; "
                "the checks didn't run.\n\n```\n" + out + "\n```")
        return (*run_checks(tmp), base_sha, None)
    finally:
        subprocess.run(["git", "worktree", "remove", "--force", tmp], cwd=worktree, capture_output=True)
        shutil.rmtree(tmp, ignore_errors=True)


def gate(job_id, merge):
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    round_dir = FACTORY / "jobs" / job_id / f"round-{job['round']}"
    commit = git(worktree, "rev-parse", "HEAD").strip()
    base = job.get("base", CONFIG["base_branch"])
    protected = protected_changes(worktree, base)
    if merge:  # job merge has already merged the base into the branch
        code, log, seconds = run_checks(worktree)
        base_sha = problem = None
    else:
        code, log, seconds, base_sha, problem = run_merged_checks(worktree, commit, base)
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    name = "merge-checks" if merge else "checks"
    (round_dir / f"{name}.log").write_text(log)
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    headline = problem.split("\n", 1)[0].rstrip(":") if problem else None
    summary = [
        f"checks.sh not run: {headline}" if problem else
        f"checks.sh {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s",
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Commit {commit[:7]}" + (", synced with the latest main before merging" if merge else
                                  f", merged with origin/{base} at {base_sha[:7]} (not pushed)" if base_sha else ""),
    ]
    tested = "" if merge else "## Base\n" + (problem or (
        f"The checks ran on the branch merged with origin/{base} at {base_sha}. "
        "The merge was not pushed; the branch and its worktree are unchanged.")) + "\n\n"
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        + tested + "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + (f"\n\n## checks.sh\nNot run. {name}.log:\n\n```\n{tail}\n```\n" if problem else
           f"\n\n## checks.sh\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n")
    )
    print(f"GATE: {verdict} ({job_id} round {job['round']}, "
          + (headline if problem else f"checks.sh exit {code} in {seconds}s")
          + (f", origin/{base} at {base_sha[:7]}" if base_sha else "")
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def hook():
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    prompt = ""
    with open(Path(event["agent_transcript_path"]).expanduser()) as f:
        for line in f:
            try:
                entry = json.loads(line)
                content = entry["message"]["content"]
            except (ValueError, KeyError, TypeError):
                continue
            prompt = content if isinstance(content, str) else " ".join(
                b.get("text", "") for b in content if isinstance(b, dict))
            if prompt:
                break
    if "Job: " not in prompt:
        sys.exit(0)  # not a factory builder
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0]
    job_file = FACTORY / "jobs" / job_id / "job.json"
    if not job_file.exists():
        sys.exit(0)
    job = json.loads(job_file.read_text())
    if job.get("kind") == "spike":
        sys.exit(0)  # throwaway code: nothing to gate
    code, log, _ = run_checks(job["worktree"])
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"factory/checks.sh fails in your worktree (exit {code}). The gate will reject this "
              f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}",
              file=sys.stderr)
        sys.exit(2)


def main(argv):
    if argv == ["--hook"]:
        hook()
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif len(argv) == 2 and argv[1] == "--merge":
        gate(argv[0], merge=True)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
