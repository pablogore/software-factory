index 0000000..5a65421
--- /dev/null
+++ b/factory/bin/guard
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""PreToolUse hook: enforce what each factory agent may write and run.
+
+Usage (from an agent's frontmatter):
+  guard <agent>        reads the hook event on stdin; exit 2 blocks the tool call
+
+Each agent writes only its own factory file; the builder may also change code
+inside .worktrees/. Every agent is kept away from merging, force pushes and
+destructive git; only the builder may commit, and it may push only its
+factory/<job-id> branch.
+
+This catches mistakes and obvious misuse, not a determined shell: a reviewer
+can still write a file through a Bash redirect. The gate and the reviews remain
+the real checks.
+"""
+
+import fnmatch
+import json
+import re
+import shlex
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+
+OWN_FILES = {
+    "intake": ["factory/jobs/*/intake.md"],
+    "spec-writer": ["factory/jobs/*/spec.md"],
+    "builder": ["factory/jobs/*/build.md", ".worktrees/*"],
+    "approver": ["factory/jobs/*/decision.md"],
+    "tech-lead": ["factory/jobs/plan.md", "factory/jobs/*/triage.md"],
+    "product-owner": ["factory/jobs/po/*.md"],
+}
+
+WRITE_TOOLS = {"Write", "Edit", "MultiEdit", "NotebookEdit"}
+
+# Never, for any agent.
+FORBIDDEN = [
+    (r"\bgh\s+pr\s+(merge|close|ready|edit)\b", "merging, closing or editing PRs is the scripts' job"),
+    (r"\bgh\s+issue\s+(close|edit|delete)\b", "issues change only through factory/bin/job"),
+    (r"\bgh\s+repo\b", "agents don't manage the repo"),
+    (r"\bgh\s+api\b.*(-X|--method)\s*(POST|PUT|PATCH|DELETE)", "agents don't write through the GitHub API"),
+    (r"\bgit\s+reset\s+--hard\b", "no git reset --hard"),
+    (r"\bgit\s+clean\b", "no git clean"),
+    (r"\bgit\s+push\b.*(--force|\s-f\b|--delete|\s\+)", "no force pushes or branch deletes"),
+    (r"--no-verify\b", "don't skip hooks"),
+    (r"\brm\s+-[a-zA-Z]*r[a-zA-Z]*f|\brm\s+-[a-zA-Z]*f[a-zA-Z]*r", "no rm -rf"),
+    (r"\bsudo\b", "no sudo"),
+]
+
+# Only the builder changes the branch.
+BUILDER_ONLY = re.compile(r"\bgit\s+(commit|push|add|rm|mv|reset|checkout|switch|rebase|merge|"
+                          r"cherry-pick|revert|stash|tag|branch\s+-[dDmM])\b|\bsed\s+-i\b")
+
+
+def block(why):
+    print(f"factory guard: {why}", file=sys.stderr)
+    sys.exit(2)
+
+
+def own_patterns(agent):
+    if agent.startswith("reviewer-"):
+        return [f"factory/jobs/*/round-*/review-{agent.removeprefix('reviewer-')}.md"]
+    return OWN_FILES.get(agent)
+
+
+def check_write(agent, path, cwd):
+    p = Path(path)
+    if not p.is_absolute():
+        p = Path(cwd) / p
+    p = p.resolve()
+    try:
+        rel = p.relative_to(REPO).as_posix()
+    except ValueError:
+        block(f"{agent} may not write outside the repo: {p}")
+    patterns = own_patterns(agent) or block(f"unknown agent {agent!r}")
+    if not any(fnmatch.fnmatch(rel, pat) for pat in patterns):
+        block(f"{agent} writes only {', '.join(patterns)}, not {rel}")
+
+
+def check_bash(agent, command):
+    for pattern, why in FORBIDDEN:
+        if re.search(pattern, command):
+            block(why)
+    if agent != "builder":
+        if BUILDER_ONLY.search(command):
+            block(f"{agent} doesn't change the branch; only the builder commits and pushes")
+        return
+    for m in re.finditer(r"\bgit\s+push\b([^;&|]*)", command):
+        args = [a for a in shlex.split(m.group(1)) if not a.startswith("-")]
+        refs = args[1:]  # after the remote
+        if not refs or any(not r.split(":")[-1].removeprefix("refs/heads/").startswith("factory/") for r in refs):
+            block("the builder pushes only its factory/<job-id> branch, named explicitly")
+
+
+def main(argv):
+    if len(argv) != 1:
+        block("usage: guard <agent>")
+    agent = argv[0]
+    event = json.load(sys.stdin)
+    tool, args = event.get("tool_name"), event.get("tool_input") or {}
+    cwd = event.get("cwd") or str(REPO)
+    if tool in WRITE_TOOLS:
+        check_write(agent, args.get("file_path") or args.get("notebook_path") or "", cwd)
+    elif tool == "Bash":
+        check_bash(agent, args.get("command", ""))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:])
